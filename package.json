{
  "name": "js-udf-tools",
  "version": "0.2.0",
  "description": "HTML to UYAP UDF (Ulusal Yargı Ağı Projesi Doküman Formatı) converter library for Node.js and React Native",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.mjs",
      "require": "./dist/interfaces/index.js"
    },
    "./rn": {
      "types": "./dist/adapters/rn/index.d.ts",
      "import": "./dist/adapters/rn/index.mjs",
      "require": "./dist/adapters/rn/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/",
    "test": "jest",
    "test:convert": "npx tsx test/run.ts",
    "release": "node scripts/release.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "node-html-parser": "^6.1.0",
    "xmlbuilder2": "^3.1.1"
  },
  "peerDependencies": {
    "expo-file-system": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "expo-file-system": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.4.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saruapp/js-udf-tools"
  },
  "bugs": {
    "url": "https://github.com/saruapp/js-udf-tools/issues"
  },
  "homepage": "https://github.com/saruapp/js-udf-tools/tree/main/packages/js-udf-tools#readme",
  "keywords": [
    "udf",
    "uyap",
    "html-to-udf",
    "converter"
  ],
  "license": "MIT"
}
